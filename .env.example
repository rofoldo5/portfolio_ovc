# Copia este archivo como .env y rellena tus valores reales
# NUNCA subas .env a GitHub

# Clave secreta de Flask para las sesiones (cámbiala por algo largo y aleatorio)
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-aqui

# URL de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://rodolfo:tu_contraseña@localhost:5432/portfolio_db
